{
  "name": "dsh-yu-speak",
  "version": "1.0.0",
  "description": "主动说话（dsh-speak-up 的修改版）：DSH 插件。没人在跟它说话的时候，它也会自己起个话头 —— 按你设的间隔掷一次本地骰子（不花模型），掷中了就走 DSH 自己的一轮（人格、历史、工具、记忆全都是它自己的）。",
  "license": "MIT",
  "author": "Speraymer",
  "contributors": [
    "Yuuyuko-uu (https://github.com/Yuuyuko-uu)"
  ],
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "initiative",
    "proactive",
    "ai-companion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Speraymer/dsh-yu-speak.git"
  },
  "homepage": "https://github.com/Speraymer/dsh-yu-speak#readme",
  "bugs": {
    "url": "https://github.com/Speraymer/dsh-yu-speak/issues"
  },
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    },
    "基于": "git+https://github.com/Yuuyuko-uu/dsh-speak-up.git"
  }
}
