{
  "name": "dsh-yu-speak",
  "version": "2.0.0",
  "description": "DSH 主动说话插件：按本地概率与冷却规则决定是否发起一轮完整会话。",
  "license": "MIT",
  "author": "Speraymer",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "initiative",
    "proactive",
    "ai-companion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Speraymer/dsh-yu-speak.git"
  },
  "homepage": "https://github.com/Speraymer/dsh-yu-speak#readme",
  "bugs": {
    "url": "https://github.com/Speraymer/dsh-yu-speak/issues"
  },
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  }
}
